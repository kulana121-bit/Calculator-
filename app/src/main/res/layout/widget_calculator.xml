<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Display Area (tapping opens main app) -->
    <LinearLayout
        android:id="@+id/widget_display_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/widget_display_bg"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widget_display_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:singleLine="true"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_display_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:singleLine="true"
            android:text="0"
            android:textColor="#1C1C1E"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Keypad Row 1: C, (, ), ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_c"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="C"
            android:textColor="#FF3B30"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_open_paren"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="("
            android:textColor="#1C1C1E"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_btn_close_paren"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text=")"
            android:textColor="#1C1C1E"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_btn_div"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="÷"
            android:textColor="#FF8C42"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 2: 7, 8, 9, × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_7"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="7"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_8"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="8"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_9"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="9"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_mul"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="×"
            android:textColor="#FF8C42"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 3: 4, 5, 6, − -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_4"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="4"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_5"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="5"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_6"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="6"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_sub"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="−"
            android:textColor="#FF8C42"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 4: 1, 2, 3, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_1"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="1"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_2"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="2"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_3"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="3"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_add"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="+"
            android:textColor="#FF8C42"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 5: 0, ., ⌫, = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_0"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="0"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_dot"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="."
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_backspace"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function_bg"
            android:text="⌫"
            android:textColor="#1C1C1E"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_btn_eq"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_bg"
            android:text="="
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
